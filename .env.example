# ── Frontend (Next.js) ──
# NEXT_PUBLIC_* vars are inlined into the production bundle at BUILD TIME.
# Set these BEFORE `npm run build` (or in your platform's build environment).

# Backend API origin the browser calls.
#   - Local dev / Tauri desktop sidecar: http://localhost:8000
#   - Docker stack:                      http://localhost:8080 (nginx edge)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Payments are processed via Creem (Merchant of Record) on the backend
# (FastAPI POST /api/v1/license/checkout). No frontend payment SDK env vars needed.
# Legacy Paddle vars (NEXT_PUBLIC_PADDLE_CLIENT_TOKEN, etc.) have been removed.

# License gate. This is a BUILD-TIME env var: Next.js inlines it into the JS
# bundle at `next build` time. Set to "false" to bypass the license check
# (for local dev / Tauri test builds). Default is "true" (enforce).
NEXT_PUBLIC_REQUIRE_LICENSE=true
