# ── Frontend (Next.js) ──
# NEXT_PUBLIC_* vars are inlined into the production bundle at BUILD TIME.
# Set these BEFORE `npm run build` (or in your platform's build environment).

# Backend API origin the browser calls.
#   - Local dev / Tauri desktop sidecar: http://localhost:8000
#   - Docker stack:                      http://localhost:8080 (nginx edge)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Paddle client vars referenced by components/PricingCard.tsx.
# NOTE: Payments are processed via Creem (Merchant of Record) on the backend.
# These Paddle vars are legacy/optional and currently unused — left for reference.
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=
NEXT_PUBLIC_PADDLE_ENVIRONMENT=production
NEXT_PUBLIC_PADDLE_PRICE_ID=
