# ══════════════════════════════════════════════════════════════════════
# PharmacyPro — Environment Variables
# Copy this file to .env and fill in your values.
# ══════════════════════════════════════════════════════════════════════

# ── PythonAnywhere ──────────────────────────────────────────────────
PYTHONANYWHERE_USERNAME=your_username
PYTHONANYWHERE_API_TOKEN=your_api_token

# ── Admin ───────────────────────────────────────────────────────────
SERVER_ADMIN_SECRET=your_admin_secret
PORTAL_SECRET=your_portal_secret

# ── Paddle Billing ──────────────────────────────────────────────────
# Server API key (for webhook processing / reference — not used in client)
PADDLE_API_KEY=pdl_live_apikey_xxxxx
# Client-side token (exposed in browser — used by Paddle.js SDK)
PADDLE_CLIENT_TOKEN=live_xxxxx
# Price ID for the one-time license product
PADDLE_PRICE_ID=pri_xxxxx
# Webhook secret (used to verify HMAC-SHA256 signatures from Paddle)
PADDLE_WEBHOOK_SECRET=pdl_ntfset_xxxxx
# Environment: sandbox or production
PADDLE_ENV=production

# ── Webhook Test Mode ──────────────────────────────────────────────
# Set to 1 to skip webhook signature verification during testing.
# NEVER set this in production.
WEBHOOK_TEST_MODE=0

# ── SMTP (License Delivery Emails) ─────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=pharmacypro.support@gmail.com
SMTP_PASSWORD=your_app_password
SENDER_EMAIL=pharmacypro.support@gmail.com

# ── Download URL ───────────────────────────────────────────────────
DOWNLOAD_URL=https://github.com/your-repo/pharmacy-hwid/releases/latest/download/pharmacy-hwid.exe

# ── Owner & Alerts ─────────────────────────────────────────────────
OWNER_EMAIL=pharmacypro.support@gmail.com

# ── Sentry Error Tracking ───────────────────────────────────────────
SENTRY_DSN=

# ── Real-Time Sale Alerts (Discord / Telegram webhook URL) ─────────
ALERT_WEBHOOK_URL=

# ── Cron Trigger Secret ────────────────────────────────────────────
CRON_SECRET=your_cron_secret

# ── GitHub Integration (Crash Reporter) ──────────────────────────────
GITHUB_TOKEN=your_github_pat
GITHUB_REPO=your-org/your-repo
