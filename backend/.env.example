# ── Legacy Flask License Server (backend/app.py) ──
# This standalone process powers the license gate / customer portal.
# It is SEPARATE from the FastAPI backend (which uses Creem MoR for payments).

# Lemon Squeezy webhook signature verification secret
LEMON_SQUEEZEY_SIGNATURE_SECRET=your_lemon_squeezy_webhook_secret_here

# Admin secret protecting the license management API
ADMIN_SECRET=your_admin_secret_here

# Flask server bind settings
FLASK_HOST=0.0.0.0
FLASK_PORT=5000
