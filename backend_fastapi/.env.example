# ── Core ──
APP_ENV=development
DEBUG=true

# ── Database (existing legacy schemas, preserved) ──
PHARMACY_DB_URL=sqlite+aiosqlite:///./pharmacy.db

# ── JWT / Auth ──
SECRET_KEY=replace-with-a-64-char-random-secret-key-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=480
REFRESH_TOKEN_EXPIRE_DAYS=30

# ── License Microservice (isolated Flask process) ──
LICENSE_GATE_URL=http://localhost:5000

# ── Creem Merchant-of-Record (MoR) ──
CREEM_API_KEY=your_creem_api_key_here
CREEM_WEBHOOK_SECRET=your_creem_webhook_secret_here
CREEM_PRODUCT_ID=your_creem_product_id_here
LICENSE_OFFLINE_GRACE_HOURS=72

# ── FastAPI Backend ──
FASTAPI_HOST=0.0.0.0
FASTAPI_PORT=8000

# ── CORS ──
FRONTEND_URL=http://localhost:3000

# ── Rate Limiting (F.1: network-layer brute-force protection) ──
POS_AUTH_RATE_LIMIT=5/minute
POS_PIN_RATE_LIMIT=5/minute

# ── POS ──
TAX_RATE=0.14
