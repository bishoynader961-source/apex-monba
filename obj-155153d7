@import "tailwindcss";
@config "../tailwind.config.js";

/* Tailwind v4 defaults the `dark:` variant to the OS prefers-color-scheme
   media query, which the MSI/WebView2 build follows instead of the app theme.
   Scope it to the `.dark` class toggled by the theme store instead.
   Default: light mode. Users can switch in settings. */
@custom-variant dark (&:where(.dark, .dark *));

/* ── RTL Layout Support ────────────────────────────────────────────────────
   Applied automatically by I18nProvider when locale is Arabic (or any RTL
   language). Logical CSS properties (margin-inline-start, padding-inline-*)
   are used throughout where possible; these rules handle legacy flex layouts
   that use directional shorthand classes.                                  */
[dir="rtl"] {
  /* Text alignment: start/end flip with reading direction */
  .text-left  { text-align: right; }
  .text-right { text-align: left;  }

  /* ── Physical directional utilities ────────────────────────────────────
     Flexbox honours `dir`, so `flex`/`grid` containers already mirror. The
     remaining breakage is physical spacing/inset utilities (`ml-*`, `pr-*`,
     `left-*`), which are direction-agnostic in Tailwind. Rather than rewrite
     ~50 call sites to logical `ms-/me-/ps-/pe-/start-/end-`, remap the values
     actually used in the app here. Unlayered rules beat Tailwind's @layer
     utilities, so these win without !important.
     Audit command:
       grep -rhoE '\-?(ml|mr|pl|pr|left|right)-[a-z0-9]+' \
         --include=*.tsx app components | sort -u                            */
  .ml-1 { margin-left: 0;     margin-right: 0.25rem; }
  .ml-2 { margin-left: 0;     margin-right: 0.5rem;  }
  .ml-3 { margin-left: 0;     margin-right: 0.75rem; }
  .ml-4 { margin-left: 0;     margin-right: 1rem;    }
  .ml-auto { margin-left: 0;  margin-right: auto;    }

  .mr-1 { margin-right: 0;    margin-left: 0.25rem; }
  .mr-2 { margin-right: 0;    margin-left: 0.5rem;  }
  .mr-3 { margin-right: 0;    margin-left: 0.75rem; }

  .pl-3  { padding-left: 0;   padding-right: 0.75rem; }
  .pl-7  { padding-left: 0;   padding-right: 1.75rem; }
  .pl-8  { padding-left: 0;   padding-right: 2rem;    }
  .pl-9  { padding-left: 0;   padding-right: 2.25rem; }
  .pl-10 { padding-left: 0;   padding-right: 2.5rem;  }

  .pr-3  { padding-right: 0;  padding-left: 0.75rem; }
  .pr-4  { padding-right: 0;  padding-left: 1rem;    }
  .pr-10 { padding-right: 0;  padding-left: 2.5rem;  }

  /* Inset utilities (icon adornments inside inputs, overlay corners). */
  .left-0 { left: auto; right: 0; }
  .left-1 { left: auto; right: 0.25rem; }
  .left-2 { left: auto; right: 0.5rem; }
  .left-3 { left: auto; right: 0.75rem; }
  .right-0 { right: auto; left: 0; }
  .right-2 { right: auto; left: 0.5rem; }
  .right-3 { right: auto; left: 0.75rem; }
  .right-4 { right: auto; left: 1rem; }
  .-left-2  { left: auto;  right: -0.5rem; }
  .-right-2 { right: auto; left: -0.5rem; }
}

* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

/* ── Clinical Green & White Theme (Light) ───────────────────── */
:root {
  /* Brand palette */
  --bg-primary: #F8FAFC;
  --bg-secondary: #FFFFFF;
  --brand-primary: #059669;
  --brand-primary-hover: #047857;
  --brand-sidebar: #064E3B;
  --brand-sidebar-hover: #065F46;
  --text-main: #1E293B;
  --text-muted: #64748B;

  --border: #E2E8F0;
  --border-focus: #059669;
  --danger: #dc2626;
  --success: #16a34a;
  --warning: #d97706;

  --shadow-sm: 0 1px 2px 0 rgba(0, 0, 0, 0.05);
  --shadow-md: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -2px rgba(0, 0, 0, 0.1);

  /* ── DashboardLayout alias tokens (prevent undefined var warnings) ── */
  --bg: var(--bg-primary);
  --bg-card: var(--bg-secondary);
  --surface: var(--bg-secondary);
  --fg: var(--text-main);
  --fg-muted: var(--text-muted);
  --sidebar: var(--brand-sidebar);

  /* Tailwind v4 CSS-first theme tokens */
  --color-background: var(--bg-primary);
  --color-surface: var(--bg-secondary);
  --color-border: var(--border);
  --color-primary: var(--brand-primary);
  --color-sidebar: var(--brand-sidebar);
  --color-fg: var(--text-main);
  --color-fg-muted: var(--text-muted);
}

/* ── User brightness (0.8–1.2, set by the Settings slider; 1 = default) ── */
:root {
  --user-brightness: 1;
}

/* ── Dark Theme (Dashboard) ──────────────────────────────────
   Baseline lightened one contrast step from the original near-black
   palette (#0A0A1A/#111111/#1A1A2E) so panels are distinguishable
   without breaking the dark identity. */
.dark {
  --bg-primary: #161629;
  --bg-secondary: #1B1B31;
  --bg-tertiary: #22223A;
  --brand-primary: #10B981;
  --brand-primary-hover: #059669;
  --brand-sidebar: #191933;
  --brand-sidebar-hover: #232340;
  --text-main: #F1F5F9;
  --text-muted: #A3AFC4;
  --text-subtle: #74819A;

  --border: #2A2A48;
  --border-focus: #10B981;
  --danger: #EF4444;
  --success: #22C55E;
  --warning: #F59E0B;

  --shadow-sm: 0 1px 2px 0 rgba(0, 0, 0, 0.25);
  --shadow-md: 0 4px 6px -1px rgba(0, 0, 0, 0.3), 0 2px 4px -2px rgba(0, 0, 0, 0.2);

  --bg: var(--bg-primary);
  --bg-card: var(--bg-secondary);
  --surface: var(--bg-tertiary);
  --fg: var(--text-main);
  --fg-muted: var(--text-muted);
  --sidebar: var(--brand-sidebar);

  --color-background: var(--bg-primary);
  --color-surface: var(--bg-secondary);
  --color-border: var(--border);
  --color-primary: var(--brand-primary);
  --color-sidebar: var(--brand-sidebar);
  --color-fg: var(--text-main);
  --color-fg-muted: var(--text-muted);
}

/* Apply user brightness to the whole app (multiplied with theme). */
html {
  filter: brightness(var(--user-brightness, 1));
}

body {
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Inter", sans-serif;
  background: var(--bg-primary);
  color: var(--text-main);
}

/* ── Phase 1: Global Typography Contrast Enforcement ─────────────────────── */
/* Force black text in light mode tables/tabs for accessibility */
:not(.dark) table,
:not(.dark) [role="tablist"],
:not(.dark) .tab-content,
:not(.dark) .data-grid {
  color: #000000;
}

:not(.dark) th,
:not(.dark) td,
:not(.dark) [role="tab"],
:not(.dark) .modal-body,
:not(.dark) .modal-row {
  color: #000000 !important;
}

/* Force white text in dark mode tables/tabs for accessibility */
.dark table,
.dark [role="tablist"],
.dark .tab-content,
.dark .data-grid {
  color: #F1F5F9;
}

.dark th,
.dark td,
.dark [role="tab"],
.dark .modal-body,
.dark .modal-row {
  color: #F1F5F9 !important;
}

/* ── Micro-animations ─────────────────────────────────────── */
@keyframes fadeInUp {
  from { opacity: 0; transform: translateY(6px); }
  to   { opacity: 1; transform: translateY(0); }
}
@keyframes pulse-soft {
  0%, 100% { opacity: 1; }
  50%       { opacity: 0.6; }
}

.animate-fade-in-up {
  animation: fadeInUp 0.2s ease-out both;
}
.animate-pulse-soft {
  animation: pulse-soft 2s ease-in-out infinite;
}

/* ── Scrollbar ────────────────────────────────────────────── */
::-webkit-scrollbar { width: 6px; height: 6px; }
::-webkit-scrollbar-track { background: transparent; }
::-webkit-scrollbar-thumb { background: #CBD5E1; border-radius: 3px; }
::-webkit-scrollbar-thumb:hover { background: #94A3B8; }

/* ── Component Standardization ────────────────────────────── */
/* Global typography overrides for tabs (light-mode scoped) */
:not(.dark) .tab-label,
:not(.dark) .tab { color: #000 !important; }
.dark .tab-label,
.dark .tab { color: #F1F5F9 !important; }
/* Generic .table class override — light mode only to prevent dark-mode regression */
:not(.dark) .table { color: #000 !important; }
.dark .table { color: #F1F5F9 !important; }

/* ── Section C: Targeted Headline Visibility Fixes ────────────────────────── */
/* Force dark text on light-mode headings that were invisible */
:not(.dark) h1.text-gray-800,
:not(.dark) h2.text-gray-800,
:not(.dark) h3.text-gray-800,
:not(.dark) h4.text-gray-800,
:not(.dark) h1.text-gray-900,
:not(.dark) h2.text-gray-900,
:not(.dark) h3.text-gray-900,
:not(.dark) h4.text-gray-900,
:not(.dark) h1.text-gray-700,
:not(.dark) h2.text-gray-700,
:not(.dark) h3.text-gray-700,
:not(.dark) h4.text-gray-700,
:not(.dark) h1.text-gray-600,
:not(.dark) h2.text-gray-600,
:not(.dark) h3.text-gray-600,
:not(.dark) h4.text-gray-600,
:not(.dark) .page-title,
:not(.dark) .section-header,
:not(.dark) .dashboard-header h1,
:not(.dark) .card-header h3,
:not(.dark) .modal-header h2,
:not(.dark) .tab-button,
:not(.dark) [role="tab"],
:not(.dark) .tab-label {
  color: #000000 !important;
}

/* Force light text on dark-mode headings that were invisible */
.dark h1.text-gray-100,
.dark h2.text-gray-100,
.dark h3.text-gray-100,
.dark h4.text-gray-100,
.dark h1.text-gray-200,
.dark h2.text-gray-200,
.dark h3.text-gray-200,
.dark h4.text-gray-200,
.dark h1.text-gray-300,
.dark h2.text-gray-300,
.dark h3.text-gray-300,
.dark h4.text-gray-300,
.dark .page-title,
.dark .section-header,
.dark .dashboard-header h1,
.dark .card-header h3,
.dark .modal-header h2,
.dark .tab-button,
.dark [role="tab"],
.dark .tab-label {
  color: #F1F5F9 !important;
}

/* Headings using var(--fg) that might be overridden */
:not(.dark) h1[style*="var(--fg)"],
:not(.dark) h2[style*="var(--fg)"],
:not(.dark) h3[style*="var(--fg)"],
:not(.dark) h4[style*="var(--fg)"],
:not(.dark) h1[style*="--fg"],
:not(.dark) h2[style*="--fg"],
:not(.dark) h3[style*="--fg"],
:not(.dark) h4[style*="--fg"] {
  color: #000000 !important;
}

.dark h1[style*="var(--fg)"],
.dark h2[style*="var(--fg)"],
.dark h3[style*="var(--fg)"],
.dark h4[style*="var(--fg)"],
.dark h1[style*="--fg"],
.dark h2[style*="--fg"],
.dark h3[style*="--fg"],
.dark h4[style*="--fg"] {
  color: #F1F5F9 !important;
}

/* ── Label Canvas ─────────────────────────────────────────── */
.label-canvas {
  border: 1px solid var(--border);
  background: var(--bg-secondary);
}
.dark .label-canvas {
  border: 1px solid var(--border);
  background: var(--bg-secondary);
}

input, select, textarea, button, table {
  border-radius: 0.375rem;
}

input:not([type="checkbox"]):not([type="radio"]),
select, textarea {
  box-shadow: var(--shadow-sm);
}

/* ── Focus ring utility ───────────────────────────────────── */
.focus-ring:focus {
  outline: 2px solid var(--brand-primary);
  outline-offset: 2px;
}

/* ── Card utility ─────────────────────────────────────────── */
.card {
  background: var(--bg-secondary);
  border: 1px solid var(--border);
  border-radius: 0.5rem;
  box-shadow: var(--shadow-sm);
}

/* ── Status badge utilities ───────────────────────────────── */
.badge-success { background: #dcfce7; color: #15803d; font-size: 11px; padding: 2px 7px; border-radius: 9999px; font-weight: 600; }
.badge-warning { background: #fef9c3; color: #a16207; font-size: 11px; padding: 2px 7px; border-radius: 9999px; font-weight: 600; }
.badge-danger  { background: #fee2e2; color: #b91c1c; font-size: 11px; padding: 2px 7px; border-radius: 9999px; font-weight: 600; }
.badge-info    { background: #dbeafe; color: #1d4ed8; font-size: 11px; padding: 2px 7px; border-radius: 9999px; font-weight: 600; }
.badge-neutral { background: #f1f5f9; color: #475569; font-size: 11px; padding: 2px 7px; border-radius: 9999px; font-weight: 600; }

/* ── Inline alert banners (non-blocking) ──────────────────── */
.alert-inline {
  display: flex;
  align-items: flex-start;
  gap: 8px;
  padding: 10px 14px;
  border-radius: 0.5rem;
  font-size: 13px;
  border: 1px solid;
}
.alert-inline.warning { background: #fffbeb; border-color: #fcd34d; color: #92400e; }
.alert-inline.danger  { background: #fef2f2; border-color: #fca5a5; color: #7f1d1d; }
.alert-inline.success { background: #f0fdf4; border-color: #86efac; color: #14532d; }
.alert-inline.info    { background: #eff6ff; border-color: #93c5fd; color: #1e3a8a; }

/* ── Receipt Print Styles ─────────────────────────────────── */
.pharmacy-receipt-preview {
  font-family: "Courier New", monospace;
  max-width: 80mm;
  margin: 0 auto;
  padding: 8mm;
}

.pharmacy-receipt {
  font-family: "Courier New", monospace;
  width: 64mm;
  margin: 0 auto;
}

.pharmacy-header { text-align: center; margin-bottom: 6px; }
.pharmacy-name { font-size: 14px; font-weight: bold; }
.pharmacy-address { font-size: 9px; color: #888; margin-top: 2px; }
.pharmacy-phone { font-size: 9px; color: #888; }

.receipt-meta { text-align: center; margin-bottom: 6px; font-size: 10px; }
.receipt-number { font-weight: bold; font-size: 11px; }
.receipt-date { font-size: 9px; color: #888; }
.cashier { font-size: 9px; color: #888; }
.patient { font-size: 9px; color: #888; }

.receipt-items { width: 100%; border-collapse: collapse; margin-bottom: 6px; font-size: 9px; }
.receipt-items th,
.receipt-items td { padding: 1px 2px; border-bottom: 1px dashed #444; }
.receipt-items th { text-align: left; font-weight: bold; }
.right { text-align: right; }

.receipt-totals { margin-bottom: 6px; font-size: 9px; }
.total-row { display: flex; justify-content: space-between; padding: 1px 0; }
.grand-total { font-weight: bold; font-size: 11px; }
.payment-method { text-align: center; font-size: 9px; margin-top: 4px; }

.receipt-footer { text-align: center; font-size: 10px; margin-top: 6px; }

@media print {
  body * { visibility: hidden; }
  #receipt-print-area, #receipt-print-area * { visibility: visible; }
  #receipt-print-area { position: static; display: block; }
}
